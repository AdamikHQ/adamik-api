meta {
  name: /api/transaction/encode
  type: http
  seq: 1
}

post {
  url: {{api_url}}/api/transaction/encode
  body: json
  auth: none
}

headers {
  Authorization: {{api_key}}
}

body:json {
  {
    "transaction": {
      "data": {
        "chainId": "tron",
        "mode": "transfer",
        "sender": "TRFc31J1drV7C8CYYjhpJxTxBe1Muf7MGg",
        "recipient": "TVKG4gUar24bpAVrDv4GSzyDRtPkjPkogL",
        "amount": "10",
        "useMaxAmount": false
      }
    }
  }
}

assert {
  res.body.transaction.data.sender: eq TRFc31J1drV7C8CYYjhpJxTxBe1Muf7MGg
  res.body.transaction.data.recipient: eq TVKG4gUar24bpAVrDv4GSzyDRtPkjPkogL
  res.body.transaction.encoded: isString 1
}
