meta {
  name: /api/transaction/encode
  type: http
  seq: 1
}

post {
  url: {{api_url}}/api/transaction/encode
  body: json
  auth: none
}

body:json {
  {
    "transaction": {
      "data": {
        "chainId": "algorand",
        "mode": "transfer",
        "sender": "RGX5XA7DWZOZ5SLG4WQSNIFKIG4CNX4VOH23YCEX56523DQEAL3QL56XZM",
        "recipient": "RGX5XA7DWZOZ5SLG4WQSNIFKIG4CNX4VOH23YCEX56523DQEAL3QL56XZM",
        "amount": "0",
        "useMaxAmount": false,
        "format": "hex"
      }
    }
  }
}

assert {
  res.body.transaction.data.sender: eq RGX5XA7DWZOZ5SLG4WQSNIFKIG4CNX4VOH23YCEX56523DQEAL3QL56XZM
  res.body.transaction.data.recipient: eq RGX5XA7DWZOZ5SLG4WQSNIFKIG4CNX4VOH23YCEX56523DQEAL3QL56XZM
  res.body.transaction.encoded: isString 1
}
