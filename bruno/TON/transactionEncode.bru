meta {
  name: /api/transaction/encode
  type: http
  seq: 1
}

post {
  url: {{api_url}}/api/transaction/encode
  body: json
  auth: none
}

headers {
  Authorization: {{api_key}}
}

body:json {
  {
    "transaction": {
      "data": {
        "chainId": "ton",
        "mode": "transfer",
        "sender": "UQCaK7Pl7qSsKOVeDa4eFtVdy6xdut-hfHRi8iLDbJU_Cw1S",
        "recipient": "UQCaK7Pl7qSsKOVeDa4eFtVdy6xdut-hfHRi8iLDbJU_Cw1S",
        "amount": "10",
        "useMaxAmount": false
      }
    }
  }
}

assert {
  res.body.transaction.data.sender: eq UQCaK7Pl7qSsKOVeDa4eFtVdy6xdut-hfHRi8iLDbJU_Cw1S
  res.body.transaction.data.recipient: eq UQCaK7Pl7qSsKOVeDa4eFtVdy6xdut-hfHRi8iLDbJU_Cw1S
  res.body.transaction.encoded: isString 1
}
