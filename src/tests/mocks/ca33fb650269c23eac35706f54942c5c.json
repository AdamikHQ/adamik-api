{
  "request": {
    "url": "https://api.mainnet.aptoslabs.com/v1/graphql",
    "method": "POST",
    "params": {
      "query": "\n    query CoinMetadata($type: String!) {\n      coin_infos(where: { coin_type: { _eq: $type } }) {\n        name\n        symbol\n        decimals\n        coin_type\n        supply_aggregator_table_handle\n      }\n    }\n  ",
      "variables": {
        "type": "0xae1a55d6d42ec911229cd901bce25ddde33ddb5cda806ad7c37437f69458a8f9::coin_factory::Emojicoin"
      }
    }
  },
  "response": {
    "data": {
      "coin_infos": [
        {
          "name": "🚀💯 emojicoin",
          "symbol": "🚀💯",
          "decimals": 8,
          "coin_type": "0xae1a55d6d42ec911229cd901bce25ddde33ddb5cda806ad7c37437f69458a8f9::coin_factory::Emojicoin",
          "supply_aggregator_table_handle": null
        }
      ]
    }
  }
}