        {
          "name": "KINGLEON",
          "symbol": "KING",
          "decimals": 8,
          "coin_type": "0x7f2817ca248c923f3e3b258196a36348629996390922cb3baac667ba068eaced::king_coin::KingCoin",
          "supply_aggregator_table_handle": null
        }
      ]
    }
  }
}