{
  "request": {
    "url": "https://api.mainnet.aptoslabs.com/v1/graphql",
    "method": "POST",
    "params": {
      "query": "\n    query CoinMetadata($type: String!) {\n      coin_infos(where: { coin_type: { _eq: $type } }) {\n        name\n        symbol\n        decimals\n        coin_type\n        supply_aggregator_table_handle\n      }\n    }\n  ",
      "variables": {
        "type": "0x3c447acb20cb97974ed3cf2591584e79b2d6691d1a22849ff96de7f79a2f0cb2::TRUMP::TRUMP"
      }
    }
  },
  "response": {
    "data": {
      "coin_infos": [
        {
          "name": "TRUMP 4 USA",
          "symbol": "TRUMP",
          "decimals": 6,
          "coin_type": "0x3c447acb20cb97974ed3cf2591584e79b2d6691d1a22849ff96de7f79a2f0cb2::TRUMP::TRUMP",
          "supply_aggregator_table_handle": null
        }
      ]
    }
  }
}