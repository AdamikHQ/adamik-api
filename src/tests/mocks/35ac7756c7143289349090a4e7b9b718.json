{
  "request": {
    "url": "https://api.mainnet.aptoslabs.com/v1/graphql",
    "method": "POST",
    "params": {
      "query": "\n    query CoinMetadata($type: String!) {\n      coin_infos(where: { coin_type: { _eq: $type } }) {\n        name\n        symbol\n        decimals\n        coin_type\n        supply_aggregator_table_handle\n      }\n    }\n  ",
      "variables": {
        "type": "0xbbc4a9af0e7fa8885bda5db08028e7b882f2c2bba1e0fedbad1d8316f73f8b2f::tortugafin::Tortugafin"
      }
    }
  },
  "response": {
    "data": {
      "coin_infos": [
        {
          "name": "TORTUGA.CASH",
          "symbol": "TICKET",
          "decimals": 8,
          "coin_type": "0xbbc4a9af0e7fa8885bda5db08028e7b882f2c2bba1e0fedbad1d8316f73f8b2f::tortugafin::Tortugafin",
          "supply_aggregator_table_handle": null
        }
      ]
    }
  }
}