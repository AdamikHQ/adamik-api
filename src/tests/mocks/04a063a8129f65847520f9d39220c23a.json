{
  "request": {
    "url": "https://api.mainnet.aptoslabs.com/v1/graphql",
    "method": "POST",
    "params": {
      "query": "\n    query CoinMetadata($type: String!) {\n      coin_infos(where: { coin_type: { _eq: $type } }) {\n        name\n        symbol\n        decimals\n        coin_type\n        supply_aggregator_table_handle\n      }\n    }\n  ",
      "variables": {
        "type": "0xbc106d0fef7e5ce159423a1a9312e011bca7fb57f961146a2f88003a779b25c2::QUEST::QUEST"
      }
    }
  },
  "response": {
    "data": {
      "coin_infos": [
        {
          "name": "▪ AptosQuest.io 🔸 NEW",
          "symbol": "COINS",
          "decimals": 6,
          "coin_type": "0xbc106d0fef7e5ce159423a1a9312e011bca7fb57f961146a2f88003a779b25c2::QUEST::QUEST",
          "supply_aggregator_table_handle": null
        }
      ]
    }
  }
}