        {
          "name": "BMTAmm",
          "symbol": "BMTAmm",
          "decimals": 8,
          "coin_type": "0x1eb35b3b9e911ca2093970ae5abfb970dbec54597d43954bb53b09d2e8356cc3::BMTAmm::BMTAmm",
          "supply_aggregator_table_handle": null
        }
      ]
    }
  }
}