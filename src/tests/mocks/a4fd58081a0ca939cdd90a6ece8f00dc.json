{
  "request": {
    "url": "https://api.mainnet.aptoslabs.com/v1/graphql",
    "method": "POST",
    "params": {
      "query": "\n    query CoinMetadata($type: String!) {\n      coin_infos(where: { coin_type: { _eq: $type } }) {\n        name\n        symbol\n        decimals\n        coin_type\n        supply_aggregator_table_handle\n      }\n    }\n  ",
      "variables": {
        "type": "0xf22bede237a07e121b56d91a491eb7bcdfd1f5907926a9e58338f964a01b17fa::asset::USDC"
      }
    }
  },
  "response": {
    "data": {
      "coin_infos": [
        {
          "name": "USD Coin",
          "symbol": "USDC",
          "decimals": 6,
          "coin_type": "0xf22bede237a07e121b56d91a491eb7bcdfd1f5907926a9e58338f964a01b17fa::asset::USDC",
          "supply_aggregator_table_handle": null
        }
      ]
    }
  }
}