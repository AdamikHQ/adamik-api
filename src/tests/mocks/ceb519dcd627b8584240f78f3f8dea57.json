{
  "request": {
    "url": "https://api.mainnet.aptoslabs.com/v1/graphql",
    "method": "POST",
    "body": {
      "query": "\n    query CoinMetadata($type: String!) {\n      coin_infos(where: { coin_type: { _eq: $type } }) {\n        name\n        symbol\n        decimals\n        coin_type\n        supply_aggregator_table_handle\n      }\n    }\n  ",
      "variables": {
        "type": "0x397071c01929cc6672a17f130bd62b1bce224309029837ce4f18214cc83ce2a7::USDC::USDC"
      }
    }
  },
  "response": {
    "status": 200,
    "body": {
      "data": {
        "coin_infos": [
          {
            "name": "💸 USDC-APTOS.ORG",
            "symbol": "USDC",
            "decimals": 6,
            "coin_type": "0x397071c01929cc6672a17f130bd62b1bce224309029837ce4f18214cc83ce2a7::USDC::USDC",
            "supply_aggregator_table_handle": null
          }
        ]
      }
    },
    "type": "json"
  }
}