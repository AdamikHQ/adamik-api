          "symbol": "$APT",
          "decimals": 6,
          "coin_type": "0x48327a479bf5c5d2e36d5e9846362cff2d99e0e27ff92859fc247893fded3fbd::APTOS::APTOS",
          "supply_aggregator_table_handle": null
        }
      ]
    }
  }
