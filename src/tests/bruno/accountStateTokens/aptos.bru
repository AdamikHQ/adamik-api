meta {
  name: aptos
  type: http
  seq: 12
}

get {
  url: {{api_url}}/api/:chainId/account/:accountId/state/tokens
  body: none
  auth: none
}

params:path {
  chainId: aptos
  accountId: 0x84b1675891d370d5de8f169031f9c3116d7add256ecf50a4bc71e3135ddba6e0
}

assert {
  res.body.balances: isDefined tokens
  res.body.balances.tokens: isArray
  res.body.balances.tokens[0].amount: matches ^\d+$
  res.status: eq 200
}
