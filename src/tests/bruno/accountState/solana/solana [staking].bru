meta {
  name: solana [staking]
  type: http
  seq: 2
}

get {
  url: {{api_url}}/api/:chainId/account/:accountId/state
  body: none
  auth: none
}

params:path {
  chainId: solana
  accountId: BJw2hkXXWj5XKKGTYd5EFSvwP6ZWKD8J6Kooa2VbiGd4
}

assert {
  res.body.balances: isDefined tokens
  res.body.balances.staking.positions[0]: isDefined 
  res.body.balances.native.total: matches ^\d+$
  res.body.balances.native.available: matches ^\d+$
  res.body.balances.staking.total: matches ^\d+$
  res.status: eq 200
}
