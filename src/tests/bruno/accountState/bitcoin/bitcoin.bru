meta {
  name: bitcoin
  type: http
  seq: 1
}

get {
  url: {{api_url}}/api/:chainId/account/:accountId/state
  body: none
  auth: none
}

params:query {
  ~pubkey: TODO
}

params:path {
  chainId: bitcoin
  accountId: bc1pwj4q5jhwlszj6rnrahd95huu6j56dvj9ltfnag55prqnpc53vpqs3lg43f
}

assert {
  res.status: eq 200
  res.body.balances.native.available: matches ^\d+$
  res.body.balances.native.total: matches ^\d+$
  res.body.balances.native.unconfirmed: matches ^\d+$
}
