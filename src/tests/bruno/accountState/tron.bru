meta {
  name: tron
  type: http
  seq: 2
}

get {
  url: {{api_url}}/api/:chainId/account/:accountId/state
  body: none
  auth: none
}

params:path {
  chainId: tron
  accountId: TL24LCps5FKwp3PoU1MvrYrwhi5LU1tHre
}

body:json {
  {
    "chainId": "tron",
    "accountId": "TL24LCps5FKwp3PoU1MvrYrwhi5LU1tHre"
  }
}

assert {
  res.status: eq 200
  res.body.balances: isDefined tokens
  res.body.balances.tokens: isArray
  res.body.balances.native.total: matches ^\d+$
  res.body.balances.native.available: matches ^\d+$
}
