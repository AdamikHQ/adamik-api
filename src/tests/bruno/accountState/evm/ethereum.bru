meta {
  name: ethereum
  type: http
  seq: 1
}

get {
  url: {{api_url}}/api/:chainId/account/:accountId/state
  body: none
  auth: none
}

params:path {
  chainId: ethereum
  accountId: 0x6450685AE9C904b7D258A897adc1fa0736dBf5Ab
}

assert {
  res.body.balances: isDefined tokens
  res.body.balances.tokens: isArray
  res.body.balances.native.total: matches ^\d+$
  res.body.balances.native.available: matches ^\d+$
  res.status: eq 200
  res.body.balances.staking.total: eq "21015403363266"
  res.body.balances.staking.locked: eq "10014126160493"
  res.body.balances.staking.unlocking: eq "11001277202773"
  res.body.balances.staking.unlocked: eq "0"
}
