meta {
  name: large account
  type: http
  seq: 2
}

get {
  url: {{api_url}}/api/:chainId/account/:accountId/state
  body: none
  auth: none
}

params:path {
  chainId: algorand
  accountId: 5TOOCJSAZBPBV4LFH26JBJYPJXGQ4XCYAT44Z6ETZT6DHQIEIBTYBYW4CM
}

assert {
  res.status: eq 200
  res.body.balances.tokens: isArray
  res.body.balances.native.total: matches ^\d+$
  res.body.balances.native.available: matches ^\d+$
}
