}

body:json {
  {
    "chainId": "cosmoshub",
    "accountId": "cosmos1g84934jpu3v5de5yqukkkhxmcvsw3u2ajxvpdl"
  }
}

assert {
  res.body.balances: isDefined tokens
  res.body.balances.tokens: isArray
  res.body.balances.native.total: eq "449637650100000000"
  res.body.balances.native.available: eq "339637650100000000"
  res.body.balances.staking: isDefined
  res.body.balances.staking.total: eq "110000000000000000"
  res.body.balances.staking.locked: eq "110000000000000000"
  res.body.balances.staking.unlocking: eq "0"
  res.body.balances.staking.unlocked: eq "0"
  res.body.balances.staking.positions: isArray
  res.body.balances.staking.rewards: isDefined
  res.body.balances.staking.rewards.native: isArray
  res.body.balances.staking.rewards.tokens: isArray
