meta {
  name: aptos
  type: http
  seq: 7
}

post {
  url: {{api_url}}/api/:chainId/transaction/validate
  body: json
  auth: none
}

params:path {
  chainId: aptos
}

body:json {
  {
    "transaction": {
      "data": {
        "mode": "transfer",
        "senderAddress": "0x061bec04ef6641af7c45c42291920cbba4d50a392bdb420b982609afd6ced807",
        "recipientAddress": "0x6b13ac8af6993a87f19fd3cd2c6b31b7cc24ac846d127922078cf8ba888c7c23",
        "amount": "55000",
        "useMaxAmount": false
      }
    }
  }
}

assert {
  res.status: eq 400
  res.body.status.errors[0].message: eq "Public key of the sender address is required"
}
