meta {
  name: stellar
  type: http
  seq: 9
}

post {
  url: {{api_url}}/api/:chainId/transaction/validate
  body: json
  auth: none
}

params:path {
  chainId: stellar
}

body:json {
  {
    "transaction": {
      "data": {
        "mode": "transfer",
        "senderAddress": "GBNJ3SOZAA52SEVZEBS2NITMIIJNM7IHIBRLOLBLKBX7NRRCCNBINOA2",
        "recipientAddress": "GBNJ3SOZAA52SEVZEBS2NITMIIJNM7IHIBRLOLBLKBX7NRRCCNBINOA2",
        "useMaxAmount": true
      }
    }
  }
}

assert {
  res.status: eq 200
  res.body.status.errors: isEmpty 
  res.body.status.warnings[0].message: eq "Same sender and recipient address"
}
