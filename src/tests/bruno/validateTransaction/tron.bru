meta {
  name: tron
  type: http
  seq: 5
}

post {
  url: {{api_url}}/api/:chainId/transaction/validate
  body: json
  auth: none
}

params:path {
  chainId: tron
}

body:json {
  {
    "transaction": {
      "data": {
        "tokenId": "TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t",
        "mode": "transferToken",
        "sender": "TCYvG9EYyHjBij8Xma6iDtLzow88888888",
        "recipient": "TCYvG9EYyHjBij8Xma6iDtLzow88888888",
        "amount": "12345",
        "useMaxAmount": false
      }
    }
  }
}

assert {
  res.status: eq 200
  res.body.status.errors: isEmpty
  res.body.status.warnings[0].message: eq "Same sender and recipient address"
}
