meta {
  name: algorand
  type: http
  seq: 1
}

post {
  url: {{api_url}}/api/:chainId/transaction/validate
  body: json
  auth: none
}

params:path {
  chainId: algorand
}

body:json {
  {
    "transaction": {
      "data": {
        "mode": "transfer",
        "sender": "RGX5XA7DWZOZ5SLG4WQSNIFKIG4CNX4VOH23YCEX56523DQEAL3QL56XZM",
        "recipient": "RGX5XA7DWZOZ5SLG4WQSNIFKIG4CNX4VOH23YCEX56523DQEAL3QL56XZM",
        "amount": "1234560",
        "useMaxAmount": false,
        "memo": "adamik-test-memo"
      }
    }
  }
}

assert {
  res.status: eq 200
  res.body.status.errors: isEmpty
  res.body.status.warnings[0].message: eq "Same sender and recipient address"
}
