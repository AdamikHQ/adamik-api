meta {
  name: solana
  type: http
  seq: 10
}

post {
  url: {{api_url}}/api/:chainId/transaction/validate
  body: json
  auth: none
}

params:path {
  chainId: solana
}

body:json {
  {
    "transaction": {
      "data":   {
        "mode": "transfer",
        "senderAddress": "kU9cUgRW9BY8mk5pCMowmkYQuTkPm1GMr3yAcBm4NSU",
        "recipientAddress": "kU9cUgRW9BY8mk5pCMowmkYQuTkPm1GMr3yAcBm4NSU",
        "useMaxAmount": true
      }
    }
  }
}

assert {
  res.status: eq 200
  res.body.status.errors: isEmpty 
  res.body.status.warnings[0].message: eq "Same sender and recipient address"
}
