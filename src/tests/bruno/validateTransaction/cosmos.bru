meta {
  name: cosmoshub
  type: http
  seq: 2
}

post {
  url: {{api_url}}/api/:chainId/transaction/validate
  body: json
  auth: none
}

params:path {
  chainId: cosmoshub
}

body:json {
  {
    "transaction": {
      "data": {
        "mode": "transfer",
        "sender": "cosmos1tkepfylhl7fmkrzsvphky2z0r7upvr9t689g2u",
        "recipient": "cosmos1tkepfylhl7fmkrzsvphky2z0r7upvr9t689g2u",
        "amount": "1234560",
        "useMaxAmount": false,
        "fees": "4000",
        "memo": "adamik-test-memo",
        "params": {
          "pubKey": "A4y0euEONBRjVuWle7ZQspFF6yeldNmhPk48BFDB"
        }
      }
    }
  }
}

assert {
  res.status: eq 200
  res.body.status.errors: isEmpty
  res.body.status.warnings[0].message: eq "Same sender and recipient address"
}
