meta {
  name: bitcoin
  type: http
  seq: 3
}

post {
  url: {{api_url}}/api/:chainId/transaction/validate
  body: json
  auth: none
}

params:path {
  chainId: bitcoin
}

body:json {
  {
    "transaction": {
      "data": {
        "mode": "transfer",
        "senderAddress": "bc1pdvagvvtvs3k35zxq7hp86x6cgp5kl6np786y50p7dj2m394rhrwq236ryc",
        "recipientAddress": "bc1pdvagvvtvs3k35zxq7hp86x6cgp5kl6np786y50p7dj2m394rhrwq236ryc",
        "amount": "1",
        "useMaxAmount": false
      }
    }
  }
}

assert {
  res.status: eq 200
  res.body.status.errors: isEmpty
  res.body.status.warnings: isEmpty
}
