meta {
  name: celestia
  type: http
  seq: 2
}

post {
  url: {{api_url}}/api/:chainId/transaction/encode
  body: json
  auth: none
}

params:path {
  chainId: celestia
}

body:json {
  {
    "transaction": {
      "data": {
        "mode": "transfer",
        "recipientAddress": "celestia1tkepfylhl7fmkrzsvphky2z0r7upvr9ttd5cs3",
        "senderAddress": "celestia1tkepfylhl7fmkrzsvphky2z0r7upvr9ttd5cs3",
        "useMaxAmount": true,
        "format": "json",
        "params": {
          "pubKey": "03833d5aebe72ca68e3816c4a466d395280929f07ccf5e75dc4e2d71c2c92da458"
        }
      }
    }
  }
}

assert {
  res.status: eq 200
  res.body.transaction.encoded.sequence: eq "7"
}
