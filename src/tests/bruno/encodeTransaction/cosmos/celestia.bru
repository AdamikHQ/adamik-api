meta {
  name: celestia
  type: http
  seq: 3
}

post {
  url: {{api_url}}/api/:chainId/transaction/encode
  body: json
  auth: none
}

params:path {
  chainId: celestia
}

body:json {
  {
    "transaction": {
      "data": {
        "mode": "transfer",
        "senderAddress": "celestia1tkepfylhl7fmkrzsvphky2z0r7upvr9ttd5cs3",
        "recipientAddress": "celestia1tkepfylhl7fmkrzsvphky2z0r7upvr9ttd5cs3",
        "useMaxAmount": true,
        "format": "json"
      }
    }
  }
}

assert {
  res.status: eq 200
  ~res.body.transaction.encoded: eq "{"account_number":"1395838","chain_id":"celestia","fee":{"amount":[{"amount":"1928","denom":"utia"}],"gas":"96366"},"memo":"","msgs":[{"type":"cosmos-sdk/MsgSend","value":{"amount":[{"amount":"145899","denom":"utia"}],"from_address":"celestia1tkepfylhl7fmkrzsvphky2z0r7upvr9ttd5cs3","to_address":"celestia1tkepfylhl7fmkrzsvphky2z0r7upvr9ttd5cs3"}}],"sequence":"7"}"
}
