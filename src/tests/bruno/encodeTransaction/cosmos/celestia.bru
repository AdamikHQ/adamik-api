meta {
  name: celestia
  type: http
  seq: 4
}

post {
  url: {{api_url}}/api/:chainId/transaction/encode
  body: json
  auth: none
}

params:path {
  chainId: celestia
}

body:json {
  {
    "transaction": {
      "data": {
        "mode": "transfer",
        "senderAddress": "celestia1tkepfylhl7fmkrzsvphky2z0r7upvr9ttd5cs3",
        "recipientAddress": "celestia1tkepfylhl7fmkrzsvphky2z0r7upvr9ttd5cs3",
        "useMaxAmount": true
      }
    }
  }
}

assert {
  res.status: eq 200
  res.body.transaction.encoded: eq 
  res.body.transaction.data.senderPubKey: eq A4M9WuvnLKaOOBbEpGbTlSgJKfB8z1513E4tccLJLaRY
}
