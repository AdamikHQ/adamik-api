meta {
  name: injective
  type: http
  seq: 4
}

post {
  url: {{api_url}}/api/:chainId/transaction/encode
  body: json
  auth: none
}

params:path {
  chainId: injective
}

body:json {
  {
    "transaction": {
      "data": {
        "mode": "transfer",
        "senderAddress": "inj1akxycslq8cjt0uffw4rjmfm3echchptu52a2dq",
        "recipientAddress": "inj1akxycslq8cjt0uffw4rjmfm3echchptu52a2dq",
        "amount": "10000",
        "memo": "adamik-test-memo"
      }
    }
  }
}

assert {
  res.status: eq 200
  res.body.transaction.encoded: eq 
  res.body.transaction.data.senderPubKey: eq AuCghumv/N4EYLDfm60KhVZ8z3p9FtP/jjJtbqihS+IB
}
