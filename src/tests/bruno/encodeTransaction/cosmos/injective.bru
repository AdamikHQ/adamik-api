meta {
  name: injective
  type: http
  seq: 4
}

post {
  url: {{api_url}}/api/:chainId/transaction/encode
  body: json
  auth: none
}

params:path {
  chainId: injective
}

body:json {
  {
    "transaction": {
      "data": {
        "mode": "transfer",
        "senderAddress": "inj1akxycslq8cjt0uffw4rjmfm3echchptu52a2dq",
        "recipientAddress": "inj1akxycslq8cjt0uffw4rjmfm3echchptu52a2dq",
        "amount": "10000",
        "memo": "adamik-test-memo",
        "format": "json"
      }
    }
  }
}

assert {
  res.status: eq 200
  ~res.body.transaction.encoded: eq "{"account_number":"5073","chain_id":"injective-1","fee":{"amount":[{"amount":"64000000000000","denom":"inj"}],"gas":"400000"},"memo":"adamik-test-memo","msgs":[{"type":"cosmos-sdk/MsgSend","value":{"amount":[{"amount":"10000","denom":"inj"}],"from_address":"inj1akxycslq8cjt0uffw4rjmfm3echchptu52a2dq","to_address":"inj1akxycslq8cjt0uffw4rjmfm3echchptu52a2dq"}}],"sequence":"86202068","timeout_height":""}"
}
