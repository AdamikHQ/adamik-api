meta {
  name: cosmoshub [stake]
  type: http
  seq: 3
}

post {
  url: {{api_url}}/api/:chainId/transaction/encode
  body: json
  auth: none
}

params:path {
  chainId: cosmoshub
}

body:json {
  {
    "transaction": {
      "data": {
        "mode": "stake",
        "senderAddress": "cosmos1g84934jpu3v5de5yqukkkhxmcvsw3u2ajxvpdl",
        "targetValidatorAddress": "cosmosvaloper1z8zjv3lntpwxua0rtpvgrcwl0nm0tltgpgs6l7",
        "amount": "10000",
        "memo": "adamik-test-memo"
      }
    }
  }
}

assert {
  res.status: eq 200
  res.body.transaction.encoded: eq 
  res.body.transaction.data.senderPubKey: eq A4hFmyZTUZlIsSSS8aC0ZHIBEMFHqBVdI9Qjpcw8Idia
  res.body.transaction.data.fees: eq "4836"
  res.body.transaction.data.gas: eq "193411"
  res.body.transaction.data.nonce: eq "167"
}
