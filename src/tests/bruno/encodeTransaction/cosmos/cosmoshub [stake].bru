meta {
  name: cosmoshub [stake]
  type: http
  seq: 2
}

post {
  url: {{api_url}}/api/:chainId/transaction/encode
  body: json
  auth: none
}

params:path {
  chainId: cosmoshub
}

body:json {
  {
    "transaction": {
      "data": {
        "mode": "stake",
        "senderAddress": "cosmos1g84934jpu3v5de5yqukkkhxmcvsw3u2ajxvpdl",
        "targetValidatorAddress": "cosmos1g84934jpu3v5de5yqukkkhxmcvsw3u2ajxvpdl",
        "amount": "10000",
        "memo": "adamik-test-memo"
      }
    }
  }
}

assert {
  res.status: eq 200
  res.body.transaction.encoded: eq 
}
