meta {
  name: cosmoshub
  type: http
  seq: 1
}

post {
  url: {{api_url}}/api/:chainId/transaction/encode
  body: json
  auth: none
}

params:path {
  chainId: cosmoshub
}

body:json {
  {
    "transaction": {
      "data": {
        "chainId": "cosmoshub",
        "mode": "transfer",
        "sender": "cosmos1g84934jpu3v5de5yqukkkhxmcvsw3u2ajxvpdl",
        "recipient": "cosmos1g84934jpu3v5de5yqukkkhxmcvsw3u2ajxvpdl",
        "amount": "10000",
        "memo": "adamik-test-memo",
        "format": "json",
        "pubKey": "A4y0euEONBRjVuWle7ZQspFF6yeldNmhPk48BFDB"
      }
    }
  }
}

assert {
  res.status: eq 200
  res.body.transaction.encoded.sequence: eq "153"
}
