        "recipientAddress": "bbn1tkepfylhl7fmkrzsvphky2z0r7upvr9tde5e49",
        "useMaxAmount": true,
        "params": {
          "pubKey": "03833d5aebe72ca68e3816c4a466d395280929f07ccf5e75dc4e2d71c2c92da458"
        }
      }
    }
  }
}

assert {
  res.status: eq 200
  ~res.body.transaction.encoded[0].value: eq
}
