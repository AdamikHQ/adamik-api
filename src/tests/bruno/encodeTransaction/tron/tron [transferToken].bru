meta {
  name: tron [transferToken]
  type: http
  seq: 2
}

post {
  url: {{api_url}}/api/:chainId/transaction/encode
  body: json
  auth: none
}

params:path {
  chainId: tron
}

body:json {
  {
    "transaction": {
      "data": {
        "mode": "transferToken",
        "tokenId": "TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t",
        "senderAddress": "TLNKsEwnzNQzkeC9p5y2D3LYxe7NS1hZAz",
        "recipientAddress": "TCYvG9EYyHjBij8Xma6iDtLzow88888888",
        "amount": "12345",
        "useMaxAmount": false
      }
    }
  }
}

assert {
  res.status: eq 200
  res.body.transaction.encoded[0].raw.value: eq 
}
