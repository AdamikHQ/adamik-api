meta {
  name: ton [transferToken]
  type: http
  seq: 2
}

post {
  url: {{api_url}}/api/:chainId/transaction/encode
  body: json
  auth: none
}

params:path {
  chainId: ton
}

body:json {
  {
    "transaction": {
      "data": {
        "tokenId": "EQCxE6mUtQJKFnGfaROTKOt1lZbDiiX1kCixRv7Nw2Id_sDs",
        "mode": "transferToken",
        "senderAddress": "EQBMunNB4UlTyogGUjHTLR3vYUKuJbHUxh0-b5nQHmd6RP57",
        "recipientAddress": "EQCsgSgfeFRIrNDUa4zMRddaFk3nFHsNKgICptbKchV4mRhM",
        "amount": "1234",
        "useMaxAmount": false
      }
    }
  }
}

assert {
  res.status: eq 200
  res.body.transaction.encoded[0].raw.value: eq 
  res.body.transaction.encoded[0].hash.value: eq 8a6743c013b5c2289fc9c08febf4c341e15645143e15a145f015012bd0160783
}
