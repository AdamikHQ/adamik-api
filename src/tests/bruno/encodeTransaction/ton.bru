meta {
  name: ton
  type: http
  seq: 3
}

post {
  url: {{api_url}}/api/:chainId/transaction/encode
  body: json
  auth: none
}

params:path {
  chainId: ton
}

body:json {
  {
    "transaction": {
      "data": {
        "tokenId": "EQAvlWFDxGF2lXm67y4yzC17wYKD9A0guwPkMs1gOsM__NOT",
        "mode": "transferToken",
        "senderAddress": "EQCsgSgfeFRIrNDUa4zMRddaFk3nFHsNKgICptbKchV4mRhM",
        "recipientAddress": "EQCsgSgfeFRIrNDUa4zMRddaFk3nFHsNKgICptbKchV4mRhM",
        "amount": "1234560",
        "useMaxAmount": false
      }
    }
  }
}

assert {
  res.status: eq 200
  res.body.transaction.encoded[0].hash.value: eq 
}
