meta {
  name: from segwit address
  type: http
  seq: 1
}

post {
  url: {{api_url}}/api/transaction/encode
  body: json
  auth: none
}

body:json {
  {
    "transaction": {
      "data": {
        "chainId": "bitcoin",
        "mode": "transfer",
        "sender": "bc1q4gwr68h0sqqwca8p40kamch69ynttq4ypw8pwu",
        "recipient": "bc1qekphvuz20qvdhkzywfe29r9vvtwxrszvaxzmqm",
        "amount": "1000",
        "useMaxAmount": false
      }
    }
  }
}

assert {
  res.status: eq 200
}
