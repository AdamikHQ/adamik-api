meta {
  name: from segwit address
  type: http
  seq: 1
}

post {
  url: {{api_url}}/api/:chainId/transaction/encode
  body: json
  auth: none
}

params:path {
  chainId: bitcoin
}

body:json {
  {
    "transaction": {
      "data": {
        "mode": "transfer",
        "senderAddress": "bc1q87kp4qcr5w5uy4vn7dqa8dcv7r0a6kwpw0r2dv",
        "recipientAddress": "bc1q87kp4qcr5w5uy4vn7dqa8dcv7r0a6kwpw0r2dv",
        "amount": "1000",
        "useMaxAmount": false
      }
    }
  }
}

assert {
  res.status: eq 200
  res.body.transaction.encoded[0].raw.value: eq 
}
