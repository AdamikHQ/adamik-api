meta {
  name: from segwit address
  type: http
  seq: 1
}

post {
  url: {{api_url}}/api/:chainId/transaction/encode
  body: json
  auth: none
}

params:path {
  chainId: bitcoin
}

body:json {
  {
    "transaction": {
      "data": {
        "mode": "transfer",
        "senderAddress": "bc1q4gwr68h0sqqwca8p40kamch69ynttq4ypw8pwu",
        "recipientAddress": "bc1qekphvuz20qvdhkzywfe29r9vvtwxrszvaxzmqm",
        "amount": "1000",
        "useMaxAmount": false
      }
    }
  }
}

assert {
  res.status: eq 200
  res.body.transaction.encoded[0].value: eq 
}
