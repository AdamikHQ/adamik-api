meta {
  name: bitcoin-signet [stake segwit]
  type: http
  seq: 8
}

post {
  url: {{api_url}}/api/:chainId/transaction/encode
  body: json
  auth: none
}

params:path {
  chainId: bitcoin-signet
}

body:json {
  {
    "transaction": {
      "data": {
        "mode": "stake",
        "senderAddress": "tb1q737mgc5em323ddazqqy2pp3lh0kh3qtlnjq5fd",
        "senderPubKey": "02bd2eb288281a9e7a15ec81b8b593f243b96fbcd2b16a1a509c1b87df95fc499c",
        "targetValidatorAddress": "d23c2c25e1fcf8fd1c21b9a402c19e2e309e531e45e92fb1e9805b6056b0cc76",
        "amount": "50000",
        "useMaxAmount": false
      }
    }
  }
}

assert {
  ~res.status: eq 200
  ~res.body.transaction.encoded[0].value: eq 
}
