meta {
  name: bitcoin-signet [stake segwit]
  type: http
  seq: 7
}

post {
  url: {{api_url}}/api/:chainId/transaction/encode
  body: json
  auth: none
}

params:path {
  chainId: bitcoin-signet
}

body:json {
  {
    "transaction": {
      "data": {
        "mode": "stake",
        "senderAddress": "tb1q737mgc5em323ddazqqy2pp3lh0kh3qtlnjq5fd",
        "senderPubKey": "02c09f288727490361db25881dd2ff09d369fbd7c3e0cac371a7134b7cf16d4cd5",
        "targetValidatorAddress": "d23c2c25e1fcf8fd1c21b9a402c19e2e309e531e45e92fb1e9805b6056b0cc76",
        "amount": "50000",
        "useMaxAmount": false
      }
    }
  }
}

assert {
  res.status: eq 200
  res.body.transaction.data.fees: eq "195"
  res.body.transaction.data.params.stakingPsbt: eq 
  res.body.transaction.data.params.slashingPsbt: eq 
  res.body.transaction.data.params.unbondingSlashingPsbt: eq 
  res.body.transaction.data.params.unbondingTransaction: eq 0200000001994fd23441ae6e9a5d8f1f48632d63289bfd50581b1d42a93b0ca08dceefeb880000000000ffffffff0180bb00000000000022512037df963438e7c21c13fbdb3b437af19365ea5f276c9ae2fe280506f16e0c435700000000
  res.body.transaction.encoded: eq 
}
