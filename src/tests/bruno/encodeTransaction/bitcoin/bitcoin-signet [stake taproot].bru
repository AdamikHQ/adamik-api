meta {
  name: bitcoin-signet [stake taproot]
  type: http
  seq: 6
}

post {
  url: {{api_url}}/api/:chainId/transaction/encode
  body: json
  auth: none
}

params:path {
  chainId: bitcoin-signet
}

body:json {
  {
    "transaction": {
      "data": {
        "mode": "stake",
        "senderAddress": "tb1pwj4q5jhwlszj6rnrahd95huu6j56dvj9ltfnag55prqnpc53vpqsxh76tx",
        "senderPubKey": "02bd2eb288281a9e7a15ec81b8b593f243b96fbcd2b16a1a509c1b87df95fc499c",
        "targetValidatorAddress": "d23c2c25e1fcf8fd1c21b9a402c19e2e309e531e45e92fb1e9805b6056b0cc76",
        "amount": "50000",
        "useMaxAmount": false
      }
    }
  }
}

assert {
  res.status: eq 200
  res.body.transaction.data.fees: eq "185"
  res.body.transaction.data.params.stakingPsbt: eq 
  res.body.transaction.data.params.slashingPsbt: eq 
  res.body.transaction.data.params.unbondingSlashingPsbt: eq 
  res.body.transaction.data.params.unbondingTransaction: eq 0200000001eb901a1489b01f3cb4ee44155264bffb28c91c578ecd83c3b0de71a65ce47ceb0000000000ffffffff0180bb000000000000225120925f6e5d2f54928dbbf7c7b989e2d0e8b6023baece6b7ae6efed0c4f5489199900000000
  res.body.transaction.encoded[0].raw.value: eq 
}
