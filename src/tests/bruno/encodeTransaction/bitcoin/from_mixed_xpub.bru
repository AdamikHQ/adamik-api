meta {
  name: from mixed xpub
  type: http
  seq: 5
}

post {
  url: {{api_url}}/api/:chainId/transaction/encode
  body: json
  auth: none
}

params:path {
  chainId: bitcoin
}

body:json {
  {
    "transaction": {
      "data": {
        "mode": "transfer",
        "senderAddress": "xpub6BtWBf3Pu6hYwJBKvEwG7JtrTxxDrSGy39HaTgZz6GTSaFWFdoCtuEXSQtoKGaYdz1emg8xTXKYwjhu3xXRPzFnYS1z4yjKj7hLDQyNeDZr",
        "recipientAddress": "bc1qekphvuz20qvdhkzywfe29r9vvtwxrszvaxzmqm",
        "useMaxAmount": true
      }
    }
  }
}

assert {
  ~res.status: eq 200
  ~res.body.transaction.data.fees: matches ^\d+$
  ~res.body.transaction.data.amount: matches ^\d+$
  ~res.body.transaction.encoded[0].raw.value: eq 
  ~res.body.status.errors: isEmpty
  ~res.body.status.warnings: isEmpty
}
