meta {
  name: from legacy address
  type: http
  seq: 3
}

post {
  url: {{api_url}}/api/:chainId/transaction/encode
  body: json
  auth: none
}

params:path {
  chainId: bitcoin
}

body:json {
  {
    "transaction": {
      "data": {
        "mode": "transfer",
        "senderAddress": "18ZFhkAfeSfwi3uTLZXYunPzdqCabLYCL9",
        "recipientAddress": "bc1qekphvuz20qvdhkzywfe29r9vvtwxrszvaxzmqm",
        "amount": "1000",
        "useMaxAmount": false
      }
    }
  }
}

assert {
  ~res.status: eq 200
  ~res.body.transaction.encoded[0].raw.value: eq 
}
