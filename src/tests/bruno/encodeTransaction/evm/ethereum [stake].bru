meta {
  name: ethereum [stake]
  type: http
  seq: 2
}

post {
  url: {{api_url}}/api/:chainId/transaction/encode
  body: json
  auth: none
}

params:path {
  chainId: ethereum
}

body:json {
  {
    "transaction": {
      "data": {
        "mode": "stake",
        "senderAddress": "0x6450685AE9C904b7D258A897adc1fa0736dBf5Ab",
        "targetValidatorAddress": "0xac0f906e433d58fa868f936e8a43230473652885",
        "amount": "10000"
      }
    }
  }
}

assert {
  res.status: eq 200
  res.body.transaction.encoded[0].raw.value: eq 0x02f86d010b8318d72a842f4eaf2c82cc2994ac0f906e433d58fa868f936e8a43230473652885822710b844f9609f080000000000000000000000006450685ae9c904b7d258a897adc1fa0736dbf5ab000000000000000000000000ac0f906e433d58fa868f936e8a43230473652885c0
}
