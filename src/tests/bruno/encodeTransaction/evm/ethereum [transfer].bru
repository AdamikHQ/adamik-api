meta {
  name: ethereum [transfer]
  type: http
  seq: 1
}

post {
  url: {{api_url}}/api/:chainId/transaction/encode
  body: json
  auth: none
}

params:path {
  chainId: ethereum
}

body:json {
  {
    "transaction": {
      "data": {
        "mode": "transfer",
        "senderAddress": "0x12f7464C9Ff094098d3F1d987a7C0Ce958E1cC17",
        "recipientAddress": "0x8bc6922Eb94e4858efaF9F433c35Bc241F69e8a6",
        "useMaxAmount": true
      }
    }
  }
}

assert {
  res.status: eq 200
  res.body.transaction.encoded[0].raw.value: eq 0x02ed01078318d72a842f4eaf2c825208948bc6922eb94e4858efaf9f433c35bc241f69e8a687366bf243a854c280c0
}
