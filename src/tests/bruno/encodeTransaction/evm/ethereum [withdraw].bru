meta {
  name: ethereum [withdraw]
  type: http
  seq: 4
}

post {
  url: {{api_url}}/api/:chainId/transaction/encode
  body: json
  auth: none
}

params:path {
  chainId: ethereum
}

body:json {
  {
    "transaction": {
      "data": {
        "mode": "withdraw",
        "senderAddress": "0x6450685AE9C904b7D258A897adc1fa0736dBf5Ab",
        "validatorAddress": "0xac0f906e433d58fa868f936e8a43230473652885",
        "stakeId": "0xac0f906e433d58fa868f936e8a43230473652885-0x6450685ae9c904b7d258a897adc1fa0736dbf5ab"
      }
    }
  }
}

assert {
  res.status: eq 400
  res.body.status.errors[0].message: contains No unlocked staking position found for stakeId
}
