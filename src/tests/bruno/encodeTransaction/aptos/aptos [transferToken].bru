meta {
  name: aptos [transferToken]
  type: http
  seq: 2
}

post {
  url: {{api_url}}/api/:chainId/transaction/encode
  body: json
  auth: none
}

params:path {
  chainId: aptos
}

body:json {
  {
    "transaction": {
      "data": {
        "mode": "transferToken",
        "tokenId": "0xf22bede237a07e121b56d91a491eb7bcdfd1f5907926a9e58338f964a01b17fa::asset::USDC",
        "senderAddress": "0xb3ad6416320fede7866b22db0eebd4e9a630a143a14674a2244d933e097d8288",
        "senderPubKey": "9790cdbe5906e7620d0a10ac5786981df5afeb52dca987ff1ee2bc272d86b8f0",
        "recipientAddress": "0x6b13ac8af6993a87f19fd3cd2c6b31b7cc24ac846d127922078cf8ba888c7c23",
        "amount": "1234560"
      }
    }
  }
}

assert {
  res.status: eq 200
  res.body.transaction.encoded[0].raw.value: matches /^[0-9a-f]+$/
}
