meta {
  name: starknet [deployAccount]
  type: http
  seq: 1
}

post {
  url: {{api_url}}/api/:chainId/transaction/encode
  body: json
  auth: none
}

params:path {
  chainId: starknet
}

body:json {
  {
    "transaction": {
      "data":   {
        "mode": "deployAccount",
        "type": "argentx",
        "senderPubKey": "0x00f3Ec751F0C50F6c903a6bE345264d56114373fD3394D74be794b539BaF6218"
      }
    }
  }
}

assert {
  res.status: eq 200
  res.body.transaction.data.params: eq 
  res.body.transaction.encoded[0].hash.value: eq 0x067faa0e8b6801746d696c28279f1d3f8230db814114aa0bae17653dbd1af8ce
}
