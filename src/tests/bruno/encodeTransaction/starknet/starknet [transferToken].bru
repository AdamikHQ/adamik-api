meta {
  name: starknet [transferToken]
  type: http
  seq: 3
}

post {
  url: {{api_url}}/api/:chainId/transaction/encode
  body: json
  auth: none
}

params:path {
  chainId: starknet
}

body:json {
  {
    "transaction": {
      "data": {
        "mode": "transferToken",
        "senderAddress": "0x05e1dfe469A9b7a504cA84102359467453aE530cFB5Ec70FF4239f91e964A08e",
        "recipientAddress": "0x064C87F27Cf25c3c29DD7CbeFdC7cB0f25Ec89384C00Ae2c8e243Ff87017489E",
        "tokenId": "0x053c91253bc9682c04929ca02ed00b3e423f6710d2ee7e0d5ebb06f3ecf368a8",
        "amount": "123"
      }
    }
  }
}

assert {
  res.status: eq 200
  ~res.body.transaction.data.params: eq 
  ~res.body.transaction.encoded[0].value: eq 0x5410d1fc40c4875d7c2eb8c05399362b24c20c72bd38d6002a5a5d4b15ac32c
}
