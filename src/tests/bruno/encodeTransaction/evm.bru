meta {
  name: ethereum
  type: http
  seq: 2
}

post {
  url: {{api_url}}/api/:chainId/transaction/encode
  body: json
  auth: none
}

params:path {
  chainId: ethereum
}

body:json {
  {
    "transaction": {
      "data":   {
        "mode": "transfer",
        "chainId": "arbitrum",
        "tokenId": "",
        "recipient": "0x8bc6922Eb94e4858efaF9F433c35Bc241F69e8a6",
        "sender": "0x8bc6922eb94e4858efaf9f433c35bc241f69e8a6",
        "amount": "1000000000000000",
        "useMaxAmount": false
      }
    }
  }
}

assert {
  res.status: eq 200
  res.body.transaction.encoded: eq "0x02ee01028393cd8a85076bf98862825208948bc6922eb94e4858efaf9f433c35bc241f69e8a687038d7ea4c6800080c0"
}
