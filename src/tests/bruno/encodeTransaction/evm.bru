meta {
  name: ethereum
  type: http
  seq: 2
}

post {
  url: {{api_url}}/api/:chainId/transaction/encode
  body: json
  auth: none
}

params:path {
  chainId: ethereum
}

body:json {
  {
    "transaction": {
      "data":   {
        "mode": "transfer",
        "chainId": "sepolia",
        "sender": "0xd9Cf97a8Eb01d27B1f5A8809273137d92758C312",
        "recipient": "0xd9Cf97a8Eb01d27B1f5A8809273137d92758C312",
        "amount": "1000",
        "useMaxAmount": false
      }
    }
  }
}

assert {
  res.status: eq 200
  res.body.transaction.encoded: eq "0x02ec83aa36a780830f42408502945a320982520894d9cf97a8eb01d27b1f5a8809273137d92758c3128203e880c0"
}
