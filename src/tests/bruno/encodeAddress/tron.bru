meta {
  name: tron-compressed
  type: http
  seq: 4
}

post {
  url: {{api_url}}/api/:chainId/address/encode
  body: json
  auth: none
}

params:path {
  chainId: tron
}

body:json {
  {
    "pubkey": "02f75ed6f6fdc227291b095edc261abfda4d9c7f815a2b04968196c81c85fb6730"
  }
}

assert {
  res.status: eq 200
  res.body.addresses[0].address: eq "TXmWqoP2A6tv38sxP5MTpS4CCBT2FpAswe"
  res.body.addresses[0].type: eq "default"
}
