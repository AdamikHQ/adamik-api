meta {
  name: bitcoin-signet [native segwit]
  type: http
  seq: 2
}

post {
  url: {{api_url}}/api/:chainId/address/encode
  body: json
  auth: none
}

params:path {
  chainId: bitcoin-signet
}

body:json {
  {
    "pubkey": "02c09f288727490361db25881dd2ff09d369fbd7c3e0cac371a7134b7cf16d4cd5"
  }
}

assert {
  res.status: eq 200
  res.body.addresses[2].type: eq p2wpkh
  res.body.addresses[2].address: eq tb1q737mgc5em323ddazqqy2pp3lh0kh3qtlnjq5fd
}
