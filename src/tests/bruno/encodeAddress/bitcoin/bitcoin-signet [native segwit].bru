meta {
  name: bitcoin-signet [native segwit]
  type: http
  seq: 2
}

post {
  url: {{api_url}}/api/:chainId/address/encode
  body: json
  auth: none
}

params:path {
  chainId: bitcoin-signet
}

body:json {
  {
    "pubkey": "02bd2eb288281a9e7a15ec81b8b593f243b96fbcd2b16a1a509c1b87df95fc499c"
  }
}

assert {
  res.status: eq 200
  res.body.addresses[2].type: eq p2wpkh
  res.body.addresses[2].address: eq tb1qnkktcxqpa6ujgs6xaqsrv72f0elm450dsdzt0u
}
