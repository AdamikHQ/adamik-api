meta {
  name: ethereum
  type: http
  seq: 3
}

post {
  url: {{api_url}}/api/:chainId/transaction/broadcast
  body: json
  auth: none
}

params:path {
  chainId: ethereum
}

body:json {
  {
    "transaction": {
      "data": {
        "senderAddress": "0xd9Cf97a8Eb01d27B1f5A8809273137d92758C312",
        "recipientAddress": "0xd9Cf97a8Eb01d27B1f5A8809273137d92758C312",
        "useMaxAmount": false,
        "fees": "232656345789000",
        "gas": "21000",
        "nonce": "0",
        "mode": "transfer",
        "amount": "1000"
      },
      "encoded": "0x02ec83aa36a780830f42408502945a320982520894d9cf97a8eb01d27b1f5a8809273137d92758c3128203e880c0",
      "signature": "DUMMY"
    }
  }
}

assert {
  res.status: eq 400
}
