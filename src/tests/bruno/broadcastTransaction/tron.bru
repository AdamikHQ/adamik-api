meta {
  name: tron
  type: http
  seq: 5
}

post {
  url: {{api_url}}/api/:chainId/transaction/broadcast
  body: json
  auth: none
}

params:path {
  chainId: tron
}

body:json {
  {
    "transaction": {
      "data": {
        "senderAddress": "TCYvG9EYyHjBij8Xma6iDtLzow88888888",
        "recipientAddress": "TCYvG9EYyHjBij8Xma6iDtLzow88888888",
        "useMaxAmount": false,
        "fees": "0",
        "params": {},
        "mode": "transferToken",
        "amount": "12345",
        "tokenId": "TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t"
      },
      "encoded": [
        {
          "raw": {
            "format": "RAW_TRANSACTION",
            "value": ""
          }
        }
      ],
      "signature": "DUMMY"
    }
  }
}

assert {
  res.status: eq 400
  res.body.status.errors[0].message: eq "Transaction broadcast failed"
}
