meta {
  name: ton
  type: http
  seq: 4
}

post {
  url: {{api_url}}/api/:chainId/transaction/broadcast
  body: json
  auth: none
}

params:path {
  chainId: ton
}

body:json {
  {
    "transaction": {
      "data": {
        "senderAddress": "EQCsgSgfeFRIrNDUa4zMRddaFk3nFHsNKgICptbKchV4mRhM",
        "recipientAddress": "EQCsgSgfeFRIrNDUa4zMRddaFk3nFHsNKgICptbKchV4mRhM",
        "memo": "adamik-test-memo",
        "mode": "transfer",
        "amount": "1234560",
        "useMaxAmount": false,
        "fees": "5759419",
        "params": {
          "pubKey": "dummy"
        }
      },
      "encoded": [
        {
          "raw": {
            "format": "BOC",
            "value": "80d38765775d557b8756bda8cb451f5380b391cdb0ec945bb70df5eba058ba13"
          }
        }
      ],
      "signature": "DUMMY"
    }
  }
}

assert {
  res.status: eq 400
  res.body.status.errors[0].message: eq "Failed to encode transaction for broadcast, verify that signature is valid"
}
