meta {
  name: aptos
  type: http
  seq: 10
}

get {
  url: {{api_url}}/api/:chainId/transaction/:transactionId?include=parsed,raw
  body: none
  auth: none
}

params:query {
  include: parsed,raw
}

params:path {
  chainId: aptos
  transactionId: 0x611b2b0b266ef042249e2fa6aa7525469235e49571385a7a239bec25e25dd6a4
}

assert {
  res.status: eq 200
  res.body.transaction.raw: isDefined
  res.body.transaction.parsed: isDefined
  res.body.transaction.parsed.timestamp: eq "1745585127054"
  res.body.transaction.parsed.nonce: matches ^\d+$
}
