meta {
  name: ethereum [stake]
  type: http
  seq: 3
}

get {
  url: {{api_url}}/api/:chainId/transaction/:transactionId?include=parsed,raw
  body: none
  auth: none
}

params:query {
  include: parsed,raw
}

params:path {
  chainId: ethereum
  transactionId: 0x5cfab22cb7b841eb0e7280df1ae15fab6317d9895cc930c86494cb7e46ca90f4
}

assert {
  res.status: eq 200
  res.body.transaction.raw: isDefined
  res.body.transaction.parsed: isDefined
  res.body.transaction.parsed.timestamp: eq "1753101767000"
}
