meta {
  name: ethereum
  type: http
  seq: 1
}

get {
  url: {{api_url}}/api/:chainId/transaction/:transactionId?include=parsed,raw
  body: none
  auth: none
}

params:query {
  include: parsed,raw
}

params:path {
  chainId: ethereum
  transactionId: 0x7e8793f89f503d5baf69d10fef2c945d8064c05460bcb49e792d9015db7628db
}

assert {
  res.status: eq 200
  res.body.transaction.raw: isDefined
  res.body.transaction.parsed: isDefined
  res.body.transaction.parsed.timestamp: eq "1725263399000"
}
