meta {
  name: bitcoin-signet
  type: http
  seq: 2
}

get {
  url: {{api_url}}/api/:chainId/transaction/:transactionId?include=raw,parsed
  body: none
  auth: none
}

params:query {
  include: raw,parsed
}

