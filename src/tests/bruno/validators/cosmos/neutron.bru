meta {
  name: neutron
  type: http
  seq: 2
}

get {
  url: {{api_url}}/api/:chainId/validators
  body: none
  auth: none
}

params:path {
  chainId: neutron
}

assert {
  res.status: eq 200
  res.body.validators: isArray
  res.body.validators[0].address: isString
  res.body.validators[0].name: isString
  res.body.validators[0].commission: isNumber
  res.body.validators[0].stakedAmount: matches ^\d+$
}
