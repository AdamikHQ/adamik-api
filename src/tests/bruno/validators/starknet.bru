meta {
  name: starknet
  type: http
  seq: 7
}

get {
  url: {{api_url}}/api/:chainId/validators
  body: none
  auth: none
}

params:path {
  chainId: starknet
}

assert {
  res.status: eq 200
  res.body.validators[0].address: eq 0x00d3b910d8c528bf0216866053c3821ac6c97983dc096bff642e9a3549210ee7
  res.body.validators[0].stakedAmount: matches ^\d+$
  res.body.validators[0].name: eq Argent
  res.body.validators[0].commission: eq 0
}
