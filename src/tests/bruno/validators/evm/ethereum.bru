meta {
  name: ethereum
  type: http
  seq: 1
}

get {
  url: {{api_url}}/api/:chainId/validators?nextPage=eyJza2lwIjo1MH0
  body: none
  auth: none
}

params:query {
  nextPage: eyJza2lwIjo1MH0
}

params:path {
