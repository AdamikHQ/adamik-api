# =============================================================================
# Adamik API - Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in the values.
# All provider API keys are optional — only configure the chains you need.

# -----------------------------------------------------------------------------
# Core (required)
# -----------------------------------------------------------------------------

# Redis connection URL (used for API key management and caching)
REDIS_URL=""

# -----------------------------------------------------------------------------
# Core (optional)
# -----------------------------------------------------------------------------

# Moesif API analytics (leave empty to disable)
#MOESIF_APPLICATION_ID=""

# Set to "true" to use mock providers responses, disable API key auth and skip real broadcast (for local dev/testing)
#TEST_ENV="true"

# -----------------------------------------------------------------------------
# Provider API keys
# -----------------------------------------------------------------------------
# These keys are used to query blockchain data from third-party providers.
# The API will still work without them for chains that have public fallback endpoints,
# but rate limits will be much lower.

# Alchemy (https://www.alchemy.com/) — EVM and Starknet chains
#ALCHEMY_API_KEY=""

# Moralis (https://moralis.io/) — EVM token/NFT indexing
#MORALIS_API_KEY=""

# Etherscan-family block explorers (https://etherscan.io/apis)
#ETHERSCAN_API_KEY_ETHEREUM=""
#ETHERSCAN_API_KEY_BASE=""
#ETHERSCAN_API_KEY_OPTIMISM=""
#ETHERSCAN_API_KEY_ARBITRUM=""
#ETHERSCAN_API_KEY_ZKSYNC=""

# Mintscan (https://www.mintscan.io/) — Cosmos chains
#MINTSCAN_API_KEY=""

# Blockchair (https://blockchair.com/) — Bitcoin and UTXO chains
#BLOCKCHAIR_API_KEY=""

# TON (https://tonapi.io/) — TON blockchain
#TON_API_KEY=""

# TON Center (https://toncenter.com/) — TON blockchain node
#TON_CENTER_API_KEY=""

# OKLink (https://www.oklink.com/) — Multi-chain explorer
#OKLINK_API_KEY=""

# TronGrid (https://www.trongrid.io/) — Tron blockchain node
#TRONGRID_API_KEY=""

# Tronscan (https://tronscan.org/) — Tron blockchain explorer
#TRONSCAN_API_KEY=""

# Starkscan (https://starkscan.co/) — Starknet explorer
#STARKSCAN_API_KEY=""

# Helius (https://helius.dev/) — Solana RPC and APIs
#HELIUS_API_KEY=""

# Solana Validators App (https://www.validators.app/) — Solana validator data
#SOLANA_VALIDATORS_APP_API_KEY=""

# -----------------------------------------------------------------------------
# Moralis node tokens (per-chain)
# -----------------------------------------------------------------------------
# Moralis dedicated node access tokens. Get them from https://moralis.io/nodes/

#MORALIS_NODE_TOKEN_ETH=""
#MORALIS_NODE_TOKEN_SEPOLIA=""
#MORALIS_NODE_TOKEN_HOLESKY=""
#MORALIS_NODE_TOKEN_ZKSYNC=""
#MORALIS_NODE_TOKEN_ZKSYNC_SEPOLIA=""
#MORALIS_NODE_TOKEN_BASE=""
#MORALIS_NODE_TOKEN_BASE_SEPOLIA=""
#MORALIS_NODE_TOKEN_OPTIMISM=""
#MORALIS_NODE_TOKEN_OPTIMISM_SEPOLIA=""
#MORALIS_NODE_TOKEN_ARBITRUM=""
#MORALIS_NODE_TOKEN_ARBITRUM_SEPOLIA=""
#MORALIS_NODE_TOKEN_POLYGON=""
#MORALIS_NODE_TOKEN_AMOY=""
#MORALIS_NODE_TOKEN_BSC=""
#MORALIS_NODE_TOKEN_BSC_TESTNET=""
#MORALIS_NODE_TOKEN_LINEA=""
#MORALIS_NODE_TOKEN_LINEA_SEPOLIA=""
#MORALIS_NODE_TOKEN_AVALANCHE=""
#MORALIS_NODE_TOKEN_GNOSIS=""
#MORALIS_NODE_TOKEN_GNOSIS_TESTNET=""
#MORALIS_NODE_TOKEN_MOONBEAM=""
#MORALIS_NODE_TOKEN_MOONRIVER=""
#MORALIS_NODE_TOKEN_MOONBASE=""
#MORALIS_NODE_TOKEN_MANTLE=""

# -----------------------------------------------------------------------------
# QuickNode tokens (per-chain)
# -----------------------------------------------------------------------------
# QuickNode endpoint access tokens. Get them from https://www.quicknode.com/

#QUICKNODE_TOKEN_COSMOS=""
#QUICKNODE_TOKEN_CELESTIA=""
#QUICKNODE_TOKEN_POLYGON=""
#QUICKNODE_TOKEN_INJECTIVE=""
#QUICKNODE_TOKEN_HYPERLIQUID=""
#QUICKNODE_TOKEN_STELLAR=""
#QUICKNODE_TOKEN_STELLAR_TESTNET=""

# -----------------------------------------------------------------------------
# Lava gateway token
# -----------------------------------------------------------------------------
# Lava Network gateway access token. Get it from https://gateway.lavanet.xyz/

#LAVA_GATEWAY_TOKEN=""
