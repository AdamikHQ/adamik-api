{
  "name": "adamik-api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "clean": "git clean -fdX -e '!.env*'",
    "dev": "next dev",
    "doc:chains": "dotenvx run -f .env.local -f .env -- tsx src/scripts/generateChainsDoc.ts",
    "doc:openapi": "dotenvx run -f .env.local -f .env -- tsx src/scripts/generateOpenAPIDoc.ts",
    "doc:providers": "dotenvx run -f .env.local -f .env -- tsx src/scripts/generateProvidersDoc.ts",
    "gen:cosmos-tokens": "dotenvx run -f .env.local -f .env -- tsx src/scripts/generateCosmosIBCTokensDefinitions.ts",
    "lint": "next lint",
    "start": "next start",
    "test:bruno:prod": "bash src/scripts/runBrunoTests.sh api.adamik.io",
    "test:bruno:local": "bash src/scripts/runBrunoTests.sh localhost",
    "test:jest": "jest",
    "prepare": "husky"
  },
  "dependencies": {
    "@babylonlabs-io/babylon-proto-ts": "0.0.3-canary.5",
